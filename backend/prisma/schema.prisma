generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Jugador {
  id                 Int                   @id @default(autoincrement())
  nombre             String
  email              String                @unique
  passwordHash       String                @map("password_hash")
  creadoEn           DateTime              @default(now()) @map("creado_en")
  progreso           Progreso?
  progresoNivel      ProgresoNivel[]
  partidas           Partida[]
  passwordResetTokens PasswordResetToken[]

  @@map("jugadores")
}

model Nivel {
  id                Int             @id @default(autoincrement())
  numero            Int             @unique
  objetivo          String
  movimientosMaximos Int            @map("movimientos_maximos")
  puntajeMeta       Int?            @map("puntaje_meta")
  configuracionJson Json            @map("configuracion_json")
  partidas          Partida[]
  progresoNivel     ProgresoNivel[]

  @@map("niveles")
}

model Partida {
  id                  Int      @id @default(autoincrement())
  jugadorId           Int      @map("jugador_id")
  nivelId             Int      @map("nivel_id")
  puntaje             Int
  movimientosUsados   Int      @map("movimientos_usados")
  tiempoNivelSegundos Int      @default(0) @map("tiempo_nivel_segundos")
  resultado           String
  fecha               DateTime @default(now())

  jugador Jugador @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  nivel   Nivel   @relation(fields: [nivelId], references: [id], onDelete: Cascade)

  @@map("partidas")
}

model Progreso {
  id               Int      @id @default(autoincrement())
  jugadorId        Int      @unique @map("jugador_id")
  nivelDesbloqueado Int     @default(1) @map("nivel_desbloqueado")
  actualizadoEn    DateTime @updatedAt @map("actualizado_en")

  jugador Jugador @relation(fields: [jugadorId], references: [id], onDelete: Cascade)

  @@map("progreso")
}

model ProgresoNivel {
  id            Int     @id @default(autoincrement())
  jugadorId     Int     @map("jugador_id")
  nivelId       Int     @map("nivel_id")
  mejorPuntaje  Int     @default(0) @map("mejor_puntaje")
  completado    Boolean @default(false)

  jugador Jugador @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  nivel   Nivel   @relation(fields: [nivelId], references: [id], onDelete: Cascade)

  @@unique([jugadorId, nivelId])
  @@map("progreso_nivel")
}

model PasswordResetToken {
  id         Int      @id @default(autoincrement())
  jugadorId  Int      @map("jugador_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  jugador Jugador @relation(fields: [jugadorId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
